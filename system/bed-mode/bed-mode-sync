#!/usr/bin/env bash
# Reconciles bed-mode with the toggle state written by caelestia's battery
# popout (services/BedMode.qml). Run by bed-mode-sync.service, which is
# triggered by bed-mode-sync.path on every write to the state file, and once
# at boot to catch a state left over from before shutdown.
#
# Bed mode is a fan curve and nothing else. It does not touch the power
# profile, CPU boost, clocks or voltages: the machine should still perform
# like itself in bed, just with the fans working harder to get the heat out
# of a restricted intake. Earlier versions clamped the profile to balanced
# and held CPU boost off, which also blocked every power-profile switch
# (see the git history for the kernel EINVAL behind that).
#
# ON:  sensitive fan curve (thinkfan-bed).
# OFF: firmware automatic fan.
set -euo pipefail

state_file=/home/john/.local/state/caelestia/bed-mode
maxperf_state=/home/john/.local/state/caelestia/max-perf
state=$(cat "$state_file" 2>/dev/null || true)

if [[ "$state" == "1" ]]; then
    # Max-perf's curve is strictly louder than this one at every temperature,
    # so while it runs it already covers bed mode. Its unit declares
    # Conflicts= on ours; starting ours here would just stop it.
    if [[ "$(cat "$maxperf_state" 2>/dev/null || true)" == "1" ]]; then
        echo "max-perf is on; its louder curve covers bed mode"
    else
        systemctl start thinkfan-bed.service
    fi
else
    systemctl stop thinkfan-bed.service
fi
