#!/usr/bin/env bash
# Reconciles bed-mode with the toggle state written by caelestia's battery
# popout (services/BedMode.qml). Run by bed-mode-sync.service, which is
# triggered by bed-mode-sync.path on every write to the state file, and once
# at boot to catch a state left over from before shutdown.
#
# ON:  balanced profile, sensitive fan curve (thinkfan), CPU boost off.
#      Boost-off is what actually curbs the heat: bursty light load boosts
#      single cores to ~4.75GHz at high voltage, which overwhelms a blocked
#      intake even at low overall utilization. Base clocks stay untouched.
# OFF: firmware auto fan, boost back on.
set -euo pipefail

state_file=/home/john/.local/state/caelestia/bed-mode
global_boost=/sys/devices/system/cpu/cpufreq/boost
state=$(cat "$state_file" 2>/dev/null || true)

# Drive the per-policy boost files and leave the global switch alone. With
# the global switch off the kernel rejects EVERY per-policy boost write with
# EINVAL (Documentation/cpu-freq/boost: "disabling global boost makes
# enabling local boost illegal"), and power-profiles-daemon writes per-policy
# boost whenever it activates a profile — so while bed mode held the global
# switch, no profile change succeeded at all, not just performance.
# Kernels without per-policy boost (pre-6.6) have no such conflict, so the
# global switch stays the fallback there.
set_boost() {
    local value=$1 path wrote=0
    for path in /sys/devices/system/cpu/cpufreq/policy*/boost; do
        [[ -w "$path" ]] || continue
        echo "$value" > "$path" && wrote=1
    done
    if (( ! wrote )) && [[ -w "$global_boost" ]]; then
        echo "$value" > "$global_boost"
    fi
}

if [[ "$state" == "1" ]]; then
    powerprofilesctl set balanced || true
    set_boost 0
    systemctl start thinkfan-bed.service
else
    systemctl stop thinkfan-bed.service
    set_boost 1
fi
