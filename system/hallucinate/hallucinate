#!/usr/bin/env python3
"""hallucinate — a one-shot desktop app whose UI *and* its imagination are
dreamed up live by an LLM.

    hallucinate "a web browser but every image is Garry Newman"

There is no real application behind the window. Gemini writes the whole thing as
HTML, CSS and JavaScript against a design system it is handed, and the browser
engine runs it. What the app can compute, it computes — a calculator really does
arithmetic, at no cost and no latency. What it cannot know it asks the model for:
the page behind a URL, an NPC's next line, the picture in an image slot. Close
the window and it is gone; nothing was ever saved, nothing was ever real.
"""
from __future__ import annotations

import argparse
import os
import sys
import threading

# Installed as a symlink on PATH, so the real directory has to be resolved before
# the sibling modules can be imported.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from dreamer import DEFAULT_MODEL, DreamError, Dreamer  # noqa: E402

KEY_FILE = os.path.expanduser("~/.config/caelestia/gemini.key")


def resolve_key(explicit: str | None) -> str | None:
    """The key is never stored in the repo — secret scanning would block that,
    rightly. Flag, then environment, then a file the installer drops."""
    if explicit:
        return explicit
    if os.environ.get("GEMINI_API_KEY"):
        return os.environ["GEMINI_API_KEY"]
    try:
        with open(KEY_FILE, encoding="utf-8") as f:
            return f.read().strip() or None
    except OSError:
        return None


def dream_into(window, dreamer: Dreamer) -> None:
    """Run one dream off the UI thread, streaming it into the splash."""
    window.show_splash()

    def work():
        try:
            body = dreamer.app(window.chunk_arrived.emit)
        except DreamError as e:
            window.dream_failed.emit(str(e))
        else:
            window.dream_done.emit(body)

    threading.Thread(target=work, daemon=True).start()


def run_windowed(dreamer: Dreamer) -> int:
    try:
        from PyQt6.QtWidgets import QApplication
        from shell import Window
    except ImportError:
        print("hallucinate: PyQt6 WebEngine is missing — "
              "sudo pacman -S --needed python-pyqt6-webengine", file=sys.stderr)
        return 1

    app = QApplication(sys.argv[:1])
    app.setApplicationName("hallucinate")
    # Wayland takes the app_id from the desktop file name, not the app name; without
    # this every dreamed app shows up to the compositor as "python3".
    app.setDesktopFileName("hallucinate")
    window = Window(dreamer)
    window.redream.connect(lambda: dream_into(window, dreamer))
    window.show()
    dream_into(window, dreamer)
    return app.exec()


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="hallucinate",
        description="Open a one-shot app whose interface and imagination are dreamed live by AI.")
    parser.add_argument("concept", nargs="?",
                        help='what to dream up, e.g. "a web browser but every image is Garry Newman"')
    parser.add_argument("--model", default=os.environ.get("HALLUCINATE_MODEL", DEFAULT_MODEL))
    parser.add_argument("--api-key")
    parser.add_argument("--print", dest="print_only", action="store_true",
                        help="print the dreamed HTML and exit, no window")
    args = parser.parse_args()

    if not args.concept:
        parser.print_help(sys.stderr)
        return 1
    api_key = resolve_key(args.api_key)
    if not api_key:
        print(f"hallucinate: no API key. Set GEMINI_API_KEY, pass --api-key, "
              f"or write it to {KEY_FILE}", file=sys.stderr)
        return 1

    dreamer = Dreamer(api_key, args.model, args.concept)
    if args.print_only:
        try:
            print(dreamer.app(lambda _chunk: None))
        except DreamError as e:
            print(f"hallucinate: {e}", file=sys.stderr)
            return 1
        return 0
    return run_windowed(dreamer)


if __name__ == "__main__":
    sys.exit(main())
