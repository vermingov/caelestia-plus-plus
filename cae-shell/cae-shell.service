[Unit]
Description=cae, the Caelestia++ shell
Documentation=https://github.com/vermingov/caelestia-plus-plus
# The desktop's own: it starts with the graphical session and goes with it.
#
# Not `Requisite=`. That refuses to start unless the target is already
# active, and only a session manager that speaks systemd — uwsm, and the
# like — ever activates it. A Hyprland started straight from a display
# manager never does, so the unit failed there with "a dependency job
# failed" and nothing in its own log to say why. `After=` still orders it
# behind the target where there is one, and `cae-session` starts it where
# there is not.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Somewhere to put what only this machine needs, that an update will not
# overwrite. The leading `-` means an absent file is not an error, which is
# the usual case. Chiefly for `ZED_DEVICE_ID=0x…`, which picks the GPU the
# shell draws on where more than one could answer and the wrong one is
# chosen: the symptom is "Adapter … is not compatible with the display
# surface for this window" in the log, and windows that never appear.
EnvironmentFile=-%h/.config/caelestia/cae-shell.env
ExecStart=%h/.local/bin/cae-shell
# A shell that falls over is a desktop with nothing on it, so it comes back.
# Not `always`: one that refuses to start is one that should say so in the
# log rather than spin.
Restart=on-failure
RestartSec=1s
# Stopping the shell stops the shell, and nothing it started for somebody.
# Apps are started in scopes of their own, but one started by an older
# shell, or one that forked before it moved itself (as Chromium does), is
# still in this unit's group — and the default ends every process in the
# group on a restart, so updating the shell used to close the apps it had
# opened. The shell's own helpers do not need it: the recorder and the
# volume follower die with the thread that started them, and the lid holder
# goes when its pipe to the shell closes.
KillMode=process
Slice=session.slice
# The bar is what the screen is drawn from; it should not wait behind a
# compile.
Nice=-5

[Install]
WantedBy=graphical-session.target
