#!/usr/bin/env python3
"""An application with a tray icon, for the rig.

It does what a real one does: owns a StatusNotifierItem name, answers for the
item's properties, and tells the watcher it is there — again whenever a
watcher appears, since the shell may start after it. Nothing else.

    rig/tray-item [ICON-NAME] [TITLE]
"""
import os
import sys

import dbus
import dbus.mainloop.glib
import dbus.service
from gi.repository import GLib

ITEM = "org.kde.StatusNotifierItem"
WATCHER = "org.kde.StatusNotifierWatcher"
PROPERTIES = "org.freedesktop.DBus.Properties"


class Item(dbus.service.Object):
    def __init__(self, bus, name, icon, title):
        self.bus_name = dbus.service.BusName(name, bus)
        super().__init__(self.bus_name, "/StatusNotifierItem")
        self.icon, self.title = icon, title

    def all(self):
        return {
            "Category": "ApplicationStatus",
            "Id": "rig-tray-item",
            "Title": self.title,
            "Status": "Active",
            "IconName": self.icon,
            "IconThemePath": "",
            "ItemIsMenu": False,
            "Menu": dbus.ObjectPath("/NO_DBUSMENU"),
        }

    @dbus.service.method(PROPERTIES, in_signature="s", out_signature="a{sv}")
    def GetAll(self, interface):
        return self.all() if interface == ITEM else {}

    @dbus.service.method(PROPERTIES, in_signature="ss", out_signature="v")
    def Get(self, interface, name):
        return self.all()[name]

    @dbus.service.method(ITEM, in_signature="ii")
    def Activate(self, x, y):
        print("Activate", x, y, flush=True)


def main():
    icon = sys.argv[1] if len(sys.argv) > 1 else "firefox"
    title = sys.argv[2] if len(sys.argv) > 2 else "Rig tray item"
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    name = f"org.kde.StatusNotifierItem-{os.getpid()}-1"
    Item(bus, name, icon, title)

    def register(*_):
        try:
            watcher = bus.get_object(WATCHER, "/StatusNotifierWatcher")
            watcher.RegisterStatusNotifierItem(name, dbus_interface=WATCHER)
            print("registered", name, flush=True)
        except dbus.exceptions.DBusException as error:
            print("no watcher yet:", error.get_dbus_name(), flush=True)

    bus.watch_name_owner(WATCHER, lambda owner: owner and register())
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()
