#!/usr/bin/env bash
# One command to bring Caelestia++ fully up to date without rebooting.
#
#   cae              pull the shell, update packages and privileged halves, restart
#   cae restart      restart the shell only
#   cae status       what is installed and what is behind
#   cae doctor       full diagnosis (doctor.sh)
#   cae log          follow the running shell's log
#   cae revert       put the machine back on upstream caelestia
#
# Everything that needs root is collected first and applied in a single sudo
# call, so you are asked for your password once or not at all. The shell is
# only restarted at the end, and a checkout that fails to come up is rolled
# back to the commit it was on.
set -euo pipefail

REPO=vermingov/caelestia-plus-plus
SHELL_DIR=${CAELESTIA_SHELL_DIR:-$HOME/.config/quickshell/caelestia}
PKG_CACHE=$HOME/.cache/caelestia/packages
PACKAGES=(caelestia++-quickshell caelestia++-shell caelestia++-cli)

bold=$(tput bold 2>/dev/null || true)
dim=$(tput dim 2>/dev/null || true)
red=$(tput setaf 1 2>/dev/null || true)
green=$(tput setaf 2 2>/dev/null || true)
yellow=$(tput setaf 3 2>/dev/null || true)
reset=$(tput sgr0 2>/dev/null || true)

say()  { printf '%s::%s %s\n' "$bold" "$reset" "$*"; }
step() { printf '%s  ->%s %s\n' "$dim" "$reset" "$*"; }
warn() { printf '%s!!%s %s\n' "$yellow" "$reset" "$*" >&2; }
die()  { printf '%s!!%s %s\n' "$red" "$reset" "$*" >&2; exit 1; }
ok()   { printf '%s  ok%s %s\n' "$green" "$reset" "$*"; }

[[ $EUID -eq 0 ]] && die "run as your normal user; the parts that need root ask for themselves"
[[ -d $SHELL_DIR/.git ]] || die "no Caelestia++ checkout at $SHELL_DIR"

# Root actions are queued as shell lines and run together at the end
root_actions=()
queue_root() { root_actions+=("$1"); }

ROOT_SCRIPT=""
cleanup_root_script() { [[ -n $ROOT_SCRIPT ]] && rm -f "$ROOT_SCRIPT"; ROOT_SCRIPT=""; }
trap cleanup_root_script EXIT

run_root_actions() {
    ((${#root_actions[@]})) || return 0

    ROOT_SCRIPT=$(mktemp) || die "could not create a temp file"
    {
        # Fail fast: a half-applied update must stop and say so rather than
        # carry on and get restarted into
        echo "set -euo pipefail"
        printf '%s\n' "${root_actions[@]}"
    } > "$ROOT_SCRIPT"

    say "applying ${#root_actions[@]} privileged step(s) — this is the only password prompt"
    sudo bash "$ROOT_SCRIPT" || die "a privileged step failed; nothing was restarted"
    cleanup_root_script
}

# --- the shell process ------------------------------------------------------

shell_pid() { pgrep -xf 'qs -c caelestia -n -d' | head -1; }

stop_shell() {
    shell_pid >/dev/null || return 0
    caelestia shell -k >/dev/null 2>&1 || true
    for _ in {1..20}; do
        shell_pid >/dev/null || return 0
        sleep 0.25
    done
    warn "the shell ignored the kill request, terminating it"
    pkill -xf 'qs -c caelestia -n -d' || true
    sleep 1
}

# Starts the shell and waits until its own log says the config loaded, so a
# QML error is reported here instead of leaving a blank desktop behind
start_shell() {
    local before after logdir
    before=$(ls -d /run/user/"$(id -u)"/quickshell/by-id/*/ 2>/dev/null | sort || true)
    setsid -f caelestia shell -d >/dev/null 2>&1 || true

    for _ in {1..40}; do
        sleep 0.25
        after=$(ls -d /run/user/"$(id -u)"/quickshell/by-id/*/ 2>/dev/null | sort || true)
        logdir=$(comm -13 <(printf '%s\n' "$before") <(printf '%s\n' "$after") | tail -1)
        [[ -n $logdir && -f $logdir/log.log ]] || continue
        if grep -q 'Configuration Loaded' "$logdir/log.log" 2>/dev/null; then
            SHELL_LOGDIR=$logdir
            return 0
        fi
    done

    SHELL_LOGDIR=${logdir:-}
    return 1
}

restart_shell() {
    stop_shell
    if start_shell; then
        ok "shell restarted (pid $(shell_pid))"
        return 0
    fi
    warn "the shell did not report a loaded config"
    [[ -n ${SHELL_LOGDIR:-} && -f $SHELL_LOGDIR/log.log ]] && {
        echo "--- last lines of $SHELL_LOGDIR/log.log"
        tail -15 "$SHELL_LOGDIR/log.log" | sed 's/\x1b\[[0-9;]*m//g'
    }
    return 1
}

# --- pieces of an update ----------------------------------------------------

# Fast-forward the checkout, leaving the commit it was on in PREVIOUS_HEAD
# The newest published release, by version order. Tags rather than the
# releases API: no rate limit, no token, and a private repo still answers
# through the user's own git credentials.
latest_release_tag() {
    git -C "$SHELL_DIR" tag --list 'v*' --sort=-v:refname | head -1
}

# The release the checkout is sitting on, or empty when it is between releases.
current_release_tag() {
    git -C "$SHELL_DIR" describe --tags --exact-match HEAD 2>/dev/null || true
}

pull_checkout() {
    local behind tag target
    PREVIOUS_HEAD=$(git -C "$SHELL_DIR" rev-parse HEAD)

    if ! git -C "$SHELL_DIR" fetch --quiet --tags --prune --prune-tags origin main 2>/dev/null; then
        warn "could not reach GitHub; keeping the current checkout"
        return 0
    fi

    # Releases, not commits: the checkout only ever moves to a tag someone
    # published on purpose, never to whatever happens to be on main.
    tag=$(latest_release_tag)
    if [[ -z $tag ]]; then
        step "no published release yet; leaving the checkout where it is"
        return 0
    fi
    target=$(git -C "$SHELL_DIR" rev-parse --verify "$tag^{commit}" 2>/dev/null) || {
        warn "release $tag does not resolve to a commit; leaving the checkout alone"
        return 0
    }

    behind=$(git -C "$SHELL_DIR" rev-list --count "HEAD..$target")
    if [[ $behind == 0 ]]; then
        step "shell checkout already on the latest release${tag:+ ($tag)}"
    elif git -C "$SHELL_DIR" merge --ff-only "$target" >/dev/null 2>&1; then
        step "updated to $tag ($behind new commit(s)):"
        git -C "$SHELL_DIR" log --format="       %h %s" "$PREVIOUS_HEAD"..HEAD | head -10
    else
        warn "cannot fast-forward to $tag (local changes?); leaving the checkout alone"
    fi
}

# Downloads any release package newer than what is installed, into PKG_CACHE,
# and leaves their paths in NEW_PACKAGES
fetch_newer_packages() {
    local json urls url name version installed
    NEW_PACKAGES=()
    json=$(curl -fsSL --max-time 25 "https://api.github.com/repos/$REPO/releases/latest" 2>/dev/null) || {
        warn "could not reach the release API; skipping package updates"
        return 0
    }
    mapfile -t urls < <(grep -o 'https://[^"]*\.pkg\.tar\.zst' <<<"$json" | sort -u)
    ((${#urls[@]})) || return 0

    mkdir -p "$PKG_CACHE"
    for url in "${urls[@]}"; do
        # GitHub percent-encodes '+' in asset URLs
        name=$(basename "$url" | sed 's/%2[Bb]/+/g')
        local pkgname=${name%-*-*-*}
        version=${name#"$pkgname"-}
        version=${version%-*.pkg.tar.zst}

        installed=$(pacman -Q "$pkgname" 2>/dev/null | awk '{print $2}' || true)
        if [[ -n $installed ]]; then
            # Already installed: only take it if the release is newer
            (( $(vercmp "$version" "$installed") > 0 )) || continue
        else
            # Not installed at all. This is an updater, not the installer —
            # the one exception is quickshell when the one on disk is broken
            [[ $pkgname == caelestia++-quickshell && -n ${NEED_QS_REBUILD:-} ]] || continue
        fi

        if [[ ! -f $PKG_CACHE/$name ]]; then
            step "downloading $name"
            curl -fL --progress-bar -o "$PKG_CACHE/$name" "$url" || { warn "download failed: $name"; continue; }
        fi
        NEW_PACKAGES+=("$PKG_CACHE/$name")
    done
}

# quickshell links Qt private API, so a Qt update can leave it unable to start
# while the running shell carries on against the deleted libraries
quickshell_broken() { ! timeout 20 qs --version >/dev/null 2>&1; }

# Root halves stamp their version in /etc/caelestia; only ones already
# installed are upgraded, never silently enabled
queue_root_half_upgrades() {
    local dir name repo_ver inst_ver
    for dir in "$SHELL_DIR"/system/*/; do
        [[ -f $dir/install.sh ]] || continue
        name=$(basename "$dir")
        # Not every system/ dir is a versioned root half; pipefail would
        # otherwise abort the loop on the first one without the line
        repo_ver=$(grep -m1 '^root_half_version=' "$dir/install.sh" | cut -d= -f2 || true)
        [[ -n $repo_ver ]] || continue
        inst_ver=$(cat "/etc/caelestia/$name.version" 2>/dev/null || true)
        [[ -n $inst_ver ]] || continue
        if (( repo_ver > inst_ver )); then
            step "$name privileged half: v$inst_ver -> v$repo_ver"
            queue_root "bash '${dir%/}/install.sh'"
        fi
    done
}

# --- commands ---------------------------------------------------------------

cmd_update() {
    PREVIOUS_HEAD=""
    NEW_PACKAGES=()

    say "updating the shell checkout"
    pull_checkout

    say "checking packages"
    if quickshell_broken; then
        warn "the installed quickshell cannot start against this Qt — it will be reinstalled or rebuilt"
        NEED_QS_REBUILD=1
    fi
    fetch_newer_packages
    if ((${#NEW_PACKAGES[@]})); then
        printf '%s\n' "${NEW_PACKAGES[@]}" | sed 's|.*/|       |'
    else
        step "packages already current"
    fi

    # quickshell goes in through its own root half rather than straight to
    # pacman: that is what also writes the scheduler override and the version
    # stamp, and verifies the binary starts before we restart anything
    local pkg qs_pkg="" plain_pkgs=()
    for pkg in ${NEW_PACKAGES[@]+"${NEW_PACKAGES[@]}"}; do
        case $(basename "$pkg") in
            caelestia++-quickshell-*) qs_pkg=$pkg ;;
            *) plain_pkgs+=("$pkg") ;;
        esac
    done
    ((${#plain_pkgs[@]})) && queue_root "pacman -U --noconfirm --ask=22 $(printf "'%s' " "${plain_pkgs[@]}")"
    if [[ -n $qs_pkg ]]; then
        queue_root "bash '$SHELL_DIR/system/quickshell/install.sh' --pkg '$qs_pkg'"
    elif [[ -n ${NEED_QS_REBUILD:-} ]]; then
        # Broken and nothing newer to install: rebuild against the Qt that is here
        queue_root "bash '$SHELL_DIR/system/quickshell/install.sh' --force"
    fi

    say "checking privileged halves"
    queue_root_half_upgrades
    ((${#root_actions[@]})) || step "privileged halves already current"

    run_root_actions

    # The fast CLI is a user-level binary built from this checkout, so a pull
    # that changes it leaves the installed one stale. Cargo is incremental:
    # with nothing to do this costs a tenth of a second.
    if command -v cargo >/dev/null; then
        say "checking the Rust binaries"
        for rust_dir in cli tools; do
            [[ -x $SHELL_DIR/$rust_dir/install.sh ]] || continue
            if "$SHELL_DIR/$rust_dir/install.sh" >/dev/null 2>&1; then
                step "$rust_dir current"
            else
                warn "$rust_dir did not build; its Python fallback stays in charge"
            fi
        done
    fi

    if quickshell_broken; then
        die "quickshell still cannot start; run 'qs --version' to see why. The shell was not restarted."
    fi

    say "restarting the shell"
    if restart_shell; then
        say "up to date: $(git -C "$SHELL_DIR" log -1 --format='%h %s' | cut -c1-60)"
        return 0
    fi

    local now
    now=$(git -C "$SHELL_DIR" rev-parse HEAD)
    if [[ -n $PREVIOUS_HEAD && $now != "$PREVIOUS_HEAD" ]]; then
        warn "rolling the checkout back to $(git -C "$SHELL_DIR" log -1 --format=%h "$PREVIOUS_HEAD")"
        git -C "$SHELL_DIR" reset --hard "$PREVIOUS_HEAD" >/dev/null
        restart_shell && die "the new commits broke the shell; rolled back and restarted. Report the log above."
    fi
    die "the shell is not running. Start it by hand with: caelestia shell -d"
}

# Upstream's own packages. caelestia-shell pulls quickshell in itself.
UPSTREAM_PKGS=(caelestia-shell caelestia-cli)

# Put the machine back on regular caelestia. Everything the fork added goes;
# everything the user made — schemes, wallpapers, saved rules, settings —
# stays exactly where it is.
cmd_revert() {
    local yes=0 answer aur="" helper name dir file backup
    [[ ${1:-} == --yes || ${1:-} == -y ]] && yes=1

    say "reverting to upstream caelestia"
    cat <<EOF
     packages   ${PACKAGES[*]}
                -> ${UPSTREAM_PKGS[*]} from the AUR
     privileged halves (firewall, protection) are uninstalled
     this checkout is moved aside, not deleted
     the cae / sandrunner / hallucinate links and the fast CLI are removed

     Settings, schemes, wallpapers and saved firewall rules are left alone.
EOF

    # The way back in has to exist before anything is taken out.
    for helper in paru yay; do
        command -v "$helper" >/dev/null && { aur=$helper; break; }
    done
    [[ -n $aur ]] || die "no AUR helper (paru or yay) found, and upstream caelestia lives in the AUR"

    if (( ! yes )); then
        [[ -t 0 ]] || die "not a terminal; run 'cae revert --yes' to skip the confirmation"
        read -rp "     type 'revert' to go ahead: " answer
        [[ $answer == revert ]] || die "nothing was changed"
    fi

    # Cached ++ packages are what makes the rollback below real.
    local rollback=()
    for name in "${PACKAGES[@]}"; do
        file=$(ls -1t "$PKG_CACHE/$name"-*.pkg.tar.zst 2>/dev/null | head -1 || true)
        [[ -n $file ]] && rollback+=("$file")
    done
    (( ${#rollback[@]} == ${#PACKAGES[@]} )) || warn "not every ++ package is cached; a failed revert may need the installer to put things back"

    say "removing the Caelestia++ half"
    for dir in "$SHELL_DIR"/system/*/; do
        [[ -f ${dir}uninstall.sh ]] || continue
        name=$(basename "$dir")
        [[ -f /etc/caelestia/$name.version ]] || continue
        step "uninstalling the $name privileged half"
        queue_root "bash '${dir}uninstall.sh' || true"
    done
    queue_root "sed -i '/^IgnorePkg.*caelestia++/d' /etc/pacman.conf"
    queue_root "pacman -Rdd --noconfirm ${PACKAGES[*]} || true"
    run_root_actions

    say "installing upstream caelestia"
    if ! "$aur" -S --needed --noconfirm "${UPSTREAM_PKGS[@]}"; then
        warn "the upstream install failed — putting Caelestia++ back"
        if (( ${#rollback[@]} )); then
            sudo pacman -U --noconfirm --ask=22 "${rollback[@]}" \
                && die "restored Caelestia++; nothing else was changed" \
                || die "could not restore the packages either — rerun the Caelestia++ installer"
        fi
        die "nothing to restore from; rerun the Caelestia++ installer"
    fi

    say "removing the user-level bits"
    if [[ -x $SHELL_DIR/cli/install.sh ]]; then
        "$SHELL_DIR/cli/install.sh" --uninstall >/dev/null 2>&1 || true
        step "fast CLI removed"
    fi
    for name in cae sandrunner hallucinate; do
        if [[ -L $HOME/.local/bin/$name ]]; then
            rm -f "$HOME/.local/bin/$name"
            step "removed ~/.local/bin/$name"
        fi
    done

    # Last, because upstream ships its shell inside the package and a config
    # directory of the same name here would shadow it.
    backup="$SHELL_DIR.caelestia++-backup-$(date +%Y%m%d-%H%M%S)"
    mv "$SHELL_DIR" "$backup"
    step "checkout moved to $backup"

    say "restarting the shell"
    pkill -x qs 2>/dev/null || true
    sleep 1
    setsid -f caelestia shell -d >/dev/null 2>&1 || warn "start it yourself with: caelestia shell -d"
    ok "back on upstream caelestia — Caelestia++ is kept at $backup"
}

cmd_restart() {
    say "restarting the shell"
    restart_shell
}

cmd_status() {
    local name installed
    say "checkout"
    printf '     %s\n' "$(git -C "$SHELL_DIR" log -1 --format='%h %ad %s' --date=short | cut -c1-72)"
    if git -C "$SHELL_DIR" fetch --quiet --tags --prune --prune-tags origin main 2>/dev/null; then
        local tag target behind here
        tag=$(latest_release_tag)
        here=$(current_release_tag)
        if [[ -z $tag ]]; then
            warn "no published release yet"
        else
            target=$(git -C "$SHELL_DIR" rev-parse --verify "$tag^{commit}")
            behind=$(git -C "$SHELL_DIR" rev-list --count "HEAD..$target")
            if [[ $behind == 0 ]]; then
                ok "on the latest release${here:+ ($here)}"
            else
                warn "release $tag is out, $behind commit(s) ahead of this checkout"
            fi
        fi
    fi

    say "packages"
    for name in "${PACKAGES[@]}"; do
        installed=$(pacman -Q "$name" 2>/dev/null | awk '{print $2}' || true)
        printf '     %-26s %s\n' "$name" "${installed:-not installed}"
    done
    quickshell_broken && warn "qs cannot start: $(timeout 20 qs --version 2>&1 | head -1 | cut -c1-90)" || ok "qs starts"

    say "privileged halves"
    local dir repo_ver inst_ver
    for dir in "$SHELL_DIR"/system/*/; do
        [[ -f $dir/install.sh ]] || continue
        name=$(basename "$dir")
        # Not every system/ dir is a versioned root half; pipefail would
        # otherwise abort the loop on the first one without the line
        repo_ver=$(grep -m1 '^root_half_version=' "$dir/install.sh" | cut -d= -f2 || true)
        [[ -n $repo_ver ]] || continue
        inst_ver=$(cat "/etc/caelestia/$name.version" 2>/dev/null || echo "-")
        if [[ $inst_ver == "-" ]]; then
            printf '     %-26s %s\n' "$name" "not installed"
        elif (( repo_ver > inst_ver )); then
            printf '     %-26s %s\n' "$name" "v$inst_ver ${yellow}(v$repo_ver available)${reset}"
        else
            printf '     %-26s %s\n' "$name" "v$inst_ver"
        fi
    done

    say "process"
    local pid
    pid=$(shell_pid || true)
    if [[ -n $pid ]]; then
        local nice
        nice=$(ps -o ni= -p "$pid" | tr -d ' ')
        ok "running (pid $pid, up $(ps -o etime= -p "$pid" | tr -d ' '), nice $nice)"
        (( nice > 0 )) && warn "the shell is scheduled as a background task; 'cae' reinstalls the quickshell root half to fix that"
    else
        warn "not running"
    fi
}

cmd_doctor() { bash "$SHELL_DIR/doctor.sh" "$@"; }

cmd_log() {
    local logdir
    logdir=$(ls -td /run/user/"$(id -u)"/quickshell/by-id/*/ 2>/dev/null | head -1)
    [[ -n $logdir ]] || die "no running shell to read a log from"
    tail -n 200 -F "$logdir/log.log"
}

case ${1:-update} in
    update|"")  shift || true; cmd_update ;;
    restart)    cmd_restart ;;
    status)     cmd_status ;;
    doctor)     shift; cmd_doctor "$@" ;;
    log)        cmd_log ;;
    revert)     shift; cmd_revert "$@" ;;
    -h|--help|help)
        sed -n '2,10p' "$0" | sed 's/^# \?//'
        ;;
    *) die "unknown command: $1 (try: cae --help)" ;;
esac
